{
  "title": "RoomPick Backend",
  "uid": "roompick-backend",
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"roompick-backend\"}[1m])) by (uri, status)",
          "legendFormat": "{{uri}} [{{status}}]"
        }
      ]
    },
    {
      "id": 2,
      "title": "5xx Error Rate (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "targets": [
        {
          "expr": "100 * sum(rate(http_server_requests_seconds_count{job=\"roompick-backend\", status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=\"roompick-backend\"}[5m]))",
          "legendFormat": "5xx %"
        }
      ]
    },
    {
      "id": 3,
      "title": "Response Time p95 (s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"roompick-backend\"}[5m])) by (le, uri))",
          "legendFormat": "p95 {{uri}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Response Time Avg (s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_sum{job=\"roompick-backend\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=\"roompick-backend\"}[5m]))",
          "legendFormat": "avg latency"
        }
      ]
    },
    {
      "id": 5,
      "title": "JVM Heap Memory Used",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{job=\"roompick-backend\", area=\"heap\"}) by (id)",
          "legendFormat": "{{id}}"
        },
        {
          "expr": "sum(jvm_memory_max_bytes{job=\"roompick-backend\", area=\"heap\"})",
          "legendFormat": "heap max"
        }
      ]
    },
    {
      "id": 6,
      "title": "CPU Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "process_cpu_usage{job=\"roompick-backend\"}",
          "legendFormat": "process cpu"
        },
        {
          "expr": "system_cpu_usage{job=\"roompick-backend\"}",
          "legendFormat": "system cpu"
        }
      ]
    },
    {
      "id": 7,
      "title": "Uptime",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "expr": "process_uptime_seconds{job=\"roompick-backend\"}" }
      ]
    },
    {
      "id": 8,
      "title": "Live Threads",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 24 },
      "targets": [
        { "expr": "jvm_threads_live_threads{job=\"roompick-backend\"}" }
      ]
    },
    {
      "id": 9,
      "title": "DB Connection Pool Active",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        {
          "expr": "hikaricp_connections_active{job=\"roompick-backend\"}",
          "legendFormat": "active"
        },
        {
          "expr": "hikaricp_connections_pending{job=\"roompick-backend\"}",
          "legendFormat": "pending"
        }
      ]
    }
  ]
}
